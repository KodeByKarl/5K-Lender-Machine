APP_NAME="Lending Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Lending rules (Annex A) -------------------------------------------------
LENDING_BUSINESS_NAME="Lending Management System"
LENDING_OVERDUE_GRACE_DAYS=0
LENDING_COLLECT_ON_SUNDAYS=true
# Used only for "custom terms" defaults; normal loans use the owner's Loan plans.
LENDING_DEFAULT_METHOD=flat
LENDING_DEFAULT_RATE_BASIS=per_term
LENDING_DEFAULT_FREQUENCY=daily
LENDING_DEFAULT_RATE=20
LENDING_DEFAULT_TERM=60
LENDING_DEFAULT_TERM_UNIT=days

# --- Initial accounts created by `php artisan db:seed` (Annex A) -------------
SETUP_ADMIN_NAME="Administrator"
SETUP_ADMIN_EMAIL=admin@lender.test
SETUP_AREA_1_NAME="Area 1"
SETUP_AREA_1_STAFF_NAME=
SETUP_AREA_1_STAFF_EMAIL=staff1@lender.test
SETUP_AREA_2_NAME="Area 2"
SETUP_AREA_2_STAFF_NAME=
SETUP_AREA_2_STAFF_EMAIL=staff2@lender.test
SETUP_AREA_3_NAME="Area 3"
SETUP_AREA_3_STAFF_NAME=
SETUP_AREA_3_STAFF_EMAIL=staff3@lender.test

# --- Vouchers and printouts --------------------------------------------------
LENDING_BUSINESS_ADDRESS=
# Optional logo file in public/, e.g. logo.png
LENDING_LOGO=
# First voucher number (continue the Client's series, e.g. 152 after 000151)
LENDING_VOUCHER_START=1
LENDING_VOUCHER_AUDITED_BY=
LENDING_VOUCHER_APPROVED_BY=

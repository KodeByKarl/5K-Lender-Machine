# Settings used ONLY when building the Windows desktop installer (BUILD_DESKTOP.bat).
# Copy to .env.desktop and edit. Your normal .env / .env.example are not touched.

APP_NAME="Lending Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# One user on one PC: no database sessions, cache or queue worker needed.
SESSION_DRIVER=file
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# --- Lending rules: keep in sync with .env ---------------------------------
LENDING_BUSINESS_NAME="ES8 Micro Merchandising"
LENDING_BUSINESS_ADDRESS=
LENDING_LOGO=
LENDING_VOUCHER_START=1
LENDING_VOUCHER_AUDITED_BY=
LENDING_VOUCHER_APPROVED_BY=

# --- First-launch accounts -------------------------------------------------
# REQUIRED: password given to the accounts created on first launch (the owner must change it).
SETUP_DEFAULT_PASSWORD=
SETUP_ADMIN_NAME="Administrator"
SETUP_ADMIN_EMAIL=admin@lender.test
SETUP_AREA_1_NAME="Area 1"
SETUP_AREA_1_STAFF_EMAIL=staff1@lender.test
SETUP_AREA_2_NAME="Area 2"
SETUP_AREA_2_STAFF_EMAIL=staff2@lender.test
SETUP_AREA_3_NAME="Area 3"
SETUP_AREA_3_STAFF_EMAIL=staff3@lender.test

# --- Desktop app -----------------------------------------------------------
NATIVEPHP_APP_ID=com.es8.lending
NATIVEPHP_APP_VERSION=1.0.0
NATIVEPHP_APP_AUTHOR="ES8 Micro Merchandising"
NATIVEPHP_APP_DESCRIPTION="Lending Management System"
NATIVEPHP_UPDATER_ENABLED=false
